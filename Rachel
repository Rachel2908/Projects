
if (acc.RecordType.Name == 'Household') {
    List<AccountContactRelation> householdMembers = [
        SELECT ContactId, Contact.AccountId
        FROM AccountContactRelation
        WHERE AccountId = :accountId
        AND Contact.AccountId != null
        WITH SECURITY_ENFORCED
    ];

    for (AccountContactRelation acr : householdMembers) {
        accountIds.add(acr.Contact.AccountId);
    }

    System.debug('Household members found: ' + accountIds);
    return accountIds;
}
